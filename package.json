{
  "name": "blog-lanke",
  "type": "module",
  "version": "0.0.1",
  "author": "lanke",
  "scripts": {
    "prepare": "pnpm exec simple-git-hooks",
    "dev": "astro dev",
    "build": "astro build --force && pagefind --site dist",
    "check:build-assets": "node scripts/check-browser-assets.mjs",
    "generate:icons": "node scripts/generate-ri-icons.mjs",
    "check:icons": "node scripts/generate-ri-icons.mjs --check",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "prettier --write .",
    "new-friend": "node scripts/new-friend.js",
    "new-post": "node scripts/new-post.js",
    "new-project": "node scripts/new-project.js"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/react": "^6.0.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@shikijs/rehype": "^4.3.1",
    "@swup/astro": "^1.8.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/chroma-js": "^3.1.2",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@waline/client": "^3.15.2",
    "astro": "^7.0.7",
    "bilibili-bangumi-component": "^0.4.0",
    "chroma-js": "^3.2.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "hastscript": "^9.0.1",
    "iconify-icon": "^3.0.2",
    "jotai": "^2.20.1",
    "katex": "^0.17.0",
    "livecodes": "^0.14.1",
    "lodash-es": "^4.18.1",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-toastify": "^11.1.0",
    "reading-time": "^1.5.0",
    "rehype-callouts": "^2.2.0",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/react": "^6.0.2",
    "@iconify/types": "^2.0.0",
    "@inquirer/prompts": "^8.5.2",
    "@testing-library/react": "^16.3.2",
    "@types/mdast": "^4.0.4",
    "astro-icon": "^1.1.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "micromark-util-symbol": "^2.0.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "simple-git-hooks": "^2.13.1",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit $1",
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,md,css,json}": "prettier --write"
  },
  "packageManager": "pnpm@11.5.0"
}
