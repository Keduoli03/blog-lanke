---
import Layout from './Layout.astro'
import Footer from '@/components/footer/Footer.astro'
import { HeaderShell } from '@/components/header/HeaderShell'
import { ToastContainer } from '@/components/ToastContainer'
import { site, author } from '@/config.json'
import Lightbox from '@/components/Lightbox.astro'
import FootnoteTooltip from '@/components/FootnoteTooltipInline.astro'
import 'katex/dist/katex.min.css'

interface Props {
  title: string
  description?: string
  image?: string
  mdTitle: string
  mdDescription: string
  mdSlug: string
  publishedTime?: Date
  modifiedTime?: Date
}

const { title, description, image, mdTitle, mdDescription, mdSlug, publishedTime, modifiedTime } =
  Astro.props
const articleUrl = new URL(mdSlug, Astro.site).href
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: mdTitle,
  description: description || mdDescription,
  url: articleUrl,
  mainEntityOfPage: articleUrl,
  image: new URL(image || site.ogImage, Astro.site).href,
  inLanguage: site.lang,
  author: {
    '@type': 'Person',
    name: author.name,
    url: site.url,
  },
  publisher: { '@id': `${site.url}/#person` },
  ...(publishedTime ? { datePublished: publishedTime.toISOString() } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime.toISOString() } : {}),
}
---

<Layout
  title={title}
  description={description}
  image={image}
  ogType="article"
  structuredData={articleSchema}
>
  <style slot="head" is:inline>
    .markdown .expressive-code .frame {
      box-shadow: none !important;
    }

    .markdown .expressive-code .frame.has-title {
      margin-top: 2rem;
      overflow: visible;
    }

    .markdown .expressive-code .frame.has-title .header {
      position: absolute !important;
      inset: auto 1.5rem 100% auto !important;
      display: flex !important;
      justify-content: flex-end !important;
      padding: 0 !important;
      background: transparent !important;
      border: 0 !important;
    }

    .markdown .expressive-code .frame.has-title .header::before,
    .markdown .expressive-code .frame.has-title .title::after {
      display: none !important;
    }

    .markdown .expressive-code .frame.has-title .title {
      height: 2rem;
      display: flex !important;
      align-items: center;
      margin: 0 !important;
      padding: 0 1rem !important;
      border: 0 !important;
      border-radius: 0.5rem 0.5rem 0 0 !important;
      background: rgb(var(--color-bg-secondary)) !important;
      color: rgb(var(--color-text-secondary));
      font-size: 0.875rem;
      line-height: 1;
    }

    .markdown .expressive-code .frame.has-title pre {
      border-radius: 0.5rem !important;
    }

    .markdown .expressive-code .frame.has-title .copy {
      inset-block-start: 0.5rem;
    }
  </style>
  <HeaderShell
    pathName={Astro.url.pathname}
    title={mdTitle}
    description={mdDescription}
    slug={mdSlug}
    client:load
  />
  <main
    class="relative z-1 pt-16 min-h-main bg-primary max-w-full overflow-x-clip"
    data-header-title={mdTitle}
    data-header-description={mdDescription}
    data-header-slug={mdSlug}
  >
    <div class="swup-transition-fade">
      <slot />
    </div>
    <ToastContainer client:idle />
  </main>
  <Footer />
  <Lightbox />
  <FootnoteTooltip />
  <script is:inline>
    ;(() => {
      function restoreReadingProgress() {
        const root = document.documentElement
        root.removeAttribute('data-restored-reading-progress')

        const article = document.querySelector('#markdown-wrapper')
        const progress = document.querySelector('[data-reading-progress]')
        if (!(article instanceof HTMLElement) || !(progress instanceof HTMLElement)) return

        let scrollY = window.scrollY
        if (scrollY === 0) {
          try {
            scrollY =
              Number(sessionStorage.getItem(`gyoza-scroll:${window.location.pathname}`)) || 0
          } catch {
            // Ignore unavailable session storage.
          }
        }

        const fullHeight = article.offsetHeight + article.offsetTop - window.innerHeight
        const percent =
          fullHeight <= 0
            ? 100
            : Math.max(0, Math.min(100, Math.floor((scrollY / fullHeight) * 100)))
        root.style.setProperty('--restored-reading-progress', `"\u8fdb\u5ea6 ${percent}%"`)
        root.setAttribute('data-restored-reading-progress', '')
      }

      restoreReadingProgress()
      document.addEventListener('swup:contentReplaced', restoreReadingProgress)
    })()
  </script>
  <script>
    const initLivecodesOnDemand = async () => {
      if (!document.querySelector('.livecodes-runner')) return
      const { initLivecodes } = await import('@/scripts/livecodes')
      initLivecodes()
    }

    document.addEventListener('astro:page-load', initLivecodesOnDemand)
    initLivecodesOnDemand()
  </script>
  <script>
    function syncHeadingAnchors() {
      document.querySelectorAll<HTMLElement>('.markdown .heading[id]').forEach((heading) => {
        const anchor = heading.querySelector<HTMLAnchorElement>(':scope > .heading-anchor')
        if (!anchor) return
        anchor.href = `#${heading.id}`
      })
    }

    function ensureImageCaptions() {
      document
        .querySelectorAll<HTMLImageElement>('.markdown figure > img[title]')
        .forEach((image) => {
          const title = image.title.trim()
          const figure = image.parentElement
          if (
            !title ||
            !(figure instanceof HTMLElement) ||
            figure.querySelector(':scope > figcaption')
          ) {
            return
          }
          const caption = document.createElement('figcaption')
          caption.textContent = title
          image.insertAdjacentElement('afterend', caption)
        })
    }

    const imageSizeStoragePrefix = 'gyoza-image-size:'

    function applyCachedImageSize(image: HTMLImageElement) {
      const source = image.dataset.originalSrc || image.currentSrc || image.src
      if (!source || image.dataset.scrollSizeBound === 'true') return

      image.dataset.scrollSizeBound = 'true'

      const apply = (width: number, height: number) => {
        if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return
        // HTML dimensions reserve the exact box before the image request finishes.
        // CSS width/max-width rules still control the rendered size.
        if (!image.hasAttribute('width')) image.setAttribute('width', String(width))
        if (!image.hasAttribute('height')) image.setAttribute('height', String(height))
      }

      try {
        const cached = JSON.parse(localStorage.getItem(`${imageSizeStoragePrefix}${source}`) || '')
        apply(Number(cached?.width), Number(cached?.height))
      } catch {
        // Ignore unavailable or malformed image-size cache entries.
      }

      const remember = () => {
        if (!image.naturalWidth || !image.naturalHeight) return
        apply(image.naturalWidth, image.naturalHeight)
        try {
          localStorage.setItem(
            `${imageSizeStoragePrefix}${source}`,
            JSON.stringify({ width: image.naturalWidth, height: image.naturalHeight }),
          )
        } catch {
          // Storage can be unavailable in privacy modes; the image still renders normally.
        }
      }

      image.addEventListener('load', remember, { passive: true })
      if (image.complete) remember()
    }

    function stabilizeMarkdownImages() {
      document.querySelectorAll<HTMLImageElement>('.markdown img').forEach(applyCachedImageSize)
    }
    function scrollToHeading(hash: string, behavior: ScrollBehavior = 'smooth') {
      if (!hash) return

      const heading = document.getElementById(decodeURIComponent(hash.slice(1)))
      if (!heading) return

      const fixedNavigationBottom = Array.from(
        document.querySelectorAll<HTMLElement>('[data-site-header], [data-header-pill]'),
      ).reduce((bottom, element) => Math.max(bottom, element.getBoundingClientRect().bottom), 64)
      const top = Math.max(
        0,
        heading.getBoundingClientRect().top + window.scrollY - fixedNavigationBottom - 32,
      )
      window.scrollTo({ top, behavior })
    }

    function restoreHashPosition() {
      if (!location.hash) return
      requestAnimationFrame(() =>
        requestAnimationFrame(() => scrollToHeading(location.hash, 'auto')),
      )
    }

    const markdownWindow = window as Window & { __markdownAnchorNavigationAttached?: boolean }
    if (!markdownWindow.__markdownAnchorNavigationAttached) {
      markdownWindow.__markdownAnchorNavigationAttached = true
      window.addEventListener(
        'click',
        (event) => {
          const source = event.target
          if (!(source instanceof Element)) return

          const anchor = source.closest<HTMLAnchorElement>('a[href^="#"]')
          if (!anchor?.hash) return

          const heading = document.getElementById(decodeURIComponent(anchor.hash.slice(1)))
          if (!heading) return
          event.stopPropagation()

          event.preventDefault()
          history.pushState(null, '', anchor.hash)
          scrollToHeading(anchor.hash)
        },
        { capture: true },
      )
    }

    syncHeadingAnchors()
    ensureImageCaptions()
    stabilizeMarkdownImages()
    restoreHashPosition()
    document.addEventListener('astro:page-load', syncHeadingAnchors)
    document.addEventListener('astro:page-load', ensureImageCaptions)
    document.addEventListener('astro:page-load', stabilizeMarkdownImages)
    document.addEventListener('astro:page-load', restoreHashPosition)
    document.addEventListener('swup:contentReplaced', syncHeadingAnchors)
    document.addEventListener('swup:contentReplaced', ensureImageCaptions)
    document.addEventListener('swup:contentReplaced', stabilizeMarkdownImages)
    document.addEventListener('swup:contentReplaced', restoreHashPosition)
  </script>
</Layout>
