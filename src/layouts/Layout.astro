---
import {
  CommonHead,
  WebAnalytics,
  ThemeLoader,
  AccentColorInjector,
  PrintVersion,
} from '@/components/head'
import { BackToTopFAB } from '@/components/BackToTopFAB'
import { ModalStack } from '@/components/ui/modal'
import { site } from '@/config.json'
import '@/styles/global.css'
import '@/styles/generated-accent.css'

interface Props {
  title?: string
  description?: string
  image?: string
  ogType?: 'website' | 'article'
  structuredData?: Record<string, unknown> | Record<string, unknown>[]
}

const { title, description, image, ogType, structuredData } = Astro.props
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <CommonHead
      title={title}
      description={description}
      image={image}
      ogType={ogType}
      structuredData={structuredData}
    />
    <WebAnalytics />
    <ThemeLoader />
    <AccentColorInjector />
    <PrintVersion />
    <script is:inline>
      ;(() => {
        const threshold = 60
        const root = document.documentElement

        // Server-rendered menu and article metadata assume scrollY === 0. When the
        // browser restores a scrolled position, switch those controls before React
        // hydrates so they do not flash in their top-of-page state.
        const apply = (scrollY) => {
          if (!Number.isFinite(scrollY) || scrollY < threshold) return false
          root.dataset.restoredScroll = 'scrolled'
          return true
        }

        let stored = 0
        try {
          stored = Number(sessionStorage.getItem(`gyoza-scroll:${window.location.pathname}`))
        } catch {
          // Ignore unavailable session storage.
        }
        apply(stored)

        // Session storage only covers same-tab refreshes of the same path. Correct
        // from the real scroll offset once the document exists, which also catches
        // restores from a new tab, a hash target, or an unwritable storage.
        window.__syncRestoredHeader = () => {
          // After the header has committed, all later scroll events are normal
          // user scrolling. Do not re-add the one-shot restoration marker, or its
          // pre-paint capsule reset styles would make the navigation transparent
          // for the rest of the visit.
          if (root.hasAttribute('data-header-ready')) {
            root.removeAttribute('data-restored-scroll')
            return
          }

          const actual = root.scrollTop || window.scrollY || 0
          if (actual === 0) return
          if (!apply(actual)) {
            root.removeAttribute('data-restored-scroll')
          }
        }

        // Browsers apply scroll restoration once layout is known, which can land
        // after the body starts parsing. Re-check at each point it may have moved.
        const sync = () => window.__syncRestoredHeader()
        document.addEventListener('DOMContentLoaded', sync)
        window.addEventListener('load', sync)
        window.addEventListener('scroll', sync, { passive: true, once: true })
      })()
    </script>
    <style is:inline>
      html:not([data-header-ready]) [data-header-menu],
      html:not([data-header-ready]) [data-header-pill],
      html:not([data-header-ready]) [data-header-pill] *,
      html:not([data-header-ready]) [data-header-background],
      html:not([data-header-ready]) [data-header-meta],
      html:not([data-header-ready]) [data-back-to-top-rocket],
      html:not([data-header-ready]) [data-header-logo] {
        transition: none !important;
        animation: none !important;
      }

      html:not([data-header-ready]) [data-header-accessible-menu] {
        visibility: hidden !important;
        pointer-events: none !important;
      }

      /* Article headers render metadata on the server, but the restored scroll
         position is only known once the client starts. Keep the capsule out of
         the pre-hydration frame until the header state is released atomically. */
      html:not([data-header-ready])
        [data-site-header][data-header-has-meta='true']
        [data-header-menu] {
        opacity: 0 !important;
        pointer-events: none !important;
      }

      /* Server-rendered markup always assumes scrollY === 0, so the menu ships with
         its capsule chrome. Strip it before first paint when the page is restoring
         to a scrolled position, otherwise the capsule flashes and fades out. */
      html[data-restored-scroll='scrolled'] [data-header-pill] {
        background-image: none !important;
        box-shadow: none !important;
        backdrop-filter: none !important;
        -webkit-backdrop-filter: none !important;
      }

      html[data-restored-scroll='scrolled'] [data-header-menu] {
        opacity: 0 !important;
        pointer-events: none !important;
      }

      html[data-restored-scroll='scrolled'] [data-header-meta] {
        opacity: 1 !important;
        translate: 0 0 !important;
        transform: translateY(0) !important;
      }

      /* Article metadata is visual-only. Keep the entire title layer transparent
         to pointer input so it can never cover the desktop avatar link after a
         scroll restore or a client-side route transition. */
      [data-site-header][data-header-has-meta='true'] [data-header-meta],
      [data-site-header][data-header-has-meta='true'] [data-header-meta] * {
        pointer-events: none !important;
      }
      /* Before hydration, use metadata rendered directly on the header. The header
         is parsed before <main>, so relying on body:has(main) here briefly treats
         article pages as regular routes and flashes the navigation menu. */
      html:not([data-header-ready])
        [data-site-header][data-header-has-meta='false']
        [data-header-menu],
      html[data-header-ready]
        body:not(:has(main[data-header-title]:not([data-header-title=''])))
        [data-header-menu] {
        opacity: 1 !important;
        pointer-events: auto !important;
      }

      html:not([data-header-ready])
        [data-site-header][data-header-has-meta='false']
        [data-header-meta],
      html[data-header-ready]
        body:not(:has(main[data-header-title]:not([data-header-title=''])))
        [data-header-meta] {
        opacity: 0 !important;
        pointer-events: none !important;
        translate: 0 1.25rem !important;
      }

      @media (max-width: 767px) {
        html[data-restored-scroll='scrolled'] [data-header-logo] {
          opacity: 0 !important;
          pointer-events: none !important;
          transition: none !important;
        }
      }

      [data-reading-progress] {
        position: relative;
      }

      html[data-restored-reading-progress] [data-reading-progress] > span {
        visibility: hidden;
      }

      html[data-restored-reading-progress] [data-reading-progress]::after {
        content: var(--restored-reading-progress);
        position: absolute;
        inset: 0;
        font-size: 0.875rem;
      }
    </style>
    <slot name="head" />
    <script>
      import 'iconify-icon'
    </script>
  </head>
  <body>
    <script is:inline>
      // Scroll restoration has happened by the time the body starts parsing, so
      // this reads the real offset before the header can paint its unscrolled state.
      window.__syncRestoredHeader?.()
    </script>
    <slot />

    <script is:inline>
      ;(() => {
        if (window.__resetScrollBeforeSwup) return
        window.__resetScrollBeforeSwup = true

        // Swup's smooth-scroll plugin is disabled so navigation cannot visibly
        // animate the previous page toward the top. Reset the viewport before
        // replacing the main container, then let the fade transition reveal the
        // next page already positioned at its top.
        const resetScrollBeforeSwap = () => {
          if (window.scrollY === 0 && document.documentElement.scrollTop === 0) return
          window.scrollTo({ top: 0, left: 0, behavior: 'auto' })
        }

        document.addEventListener('astro:before-swap', resetScrollBeforeSwap)
      })()
    </script>

    <BackToTopFAB client:load />
    <ModalStack client:idle />
  </body>
</html>
