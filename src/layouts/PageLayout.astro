---
import Layout from './Layout.astro'
import { HeaderShell } from '@/components/header/HeaderShell'
import Footer from '@/components/footer/Footer.astro'

interface Props {
  title?: string
  description?: string
  image?: string
  showBackToTop?: boolean
}

const { title, description, image, showBackToTop = false } = Astro.props
---

<Layout title={title} description={description} image={image} showBackToTop={showBackToTop}>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <HeaderShell pathName={Astro.url.pathname} client:load />
  <main
    class="relative z-1 pt-16 min-h-main bg-primary"
    data-header-title=""
    data-header-description=""
    data-header-slug=""
  >
    <div class="swup-transition-fade">
      <slot />
    </div>
  </main>
  <Footer />
</Layout>
