---
interface Props {
  slug: string
  title: string
  body: string
  embedded?: boolean
}

const { slug, title, body, embedded = false } = Astro.props
const apiBaseUrl = 'https://vercel-cf-summary.vercel.app'

const containerClass = embedded
  ? 'p-4 transition ai-summary-card data-pagefind-ignore'
  : 'mb-6 p-4 rounded-lg bg-amber-300/10 border border-amber-300 transition ai-summary-card data-pagefind-ignore'
---

<div id={`ai-summary-${slug}`} class={containerClass}>
  <div class="flex items-center gap-2 mb-2 font-bold">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-6 h-6"
      ><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path
        d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"
      ></path></svg
    >
    <span>AI 摘要</span>
  </div>
  <p id={`ai-summary-text-${slug}`} class="text-sm leading-relaxed opacity-80 break-words">
    正在生成中...
  </p>
</div>

<script is:inline define:vars={{ slug, title, body, apiBaseUrl }}>
  // 添加延迟，确保 DOM 完全加载
  setTimeout(async () => {
    const container = document.getElementById(`ai-summary-${slug}`)
    const outputEl = document.getElementById(`ai-summary-text-${slug}`)

    if (!container || !outputEl) {
      console.error('容器元素未找到')
      return
    }

    const controller = new AbortController()
    const timeoutId = setTimeout(() => controller.abort(), 65_000)

    try {
      const articleText = `标题: ${title}\n\n${body}`

      const response = await fetch(`${apiBaseUrl}/api/summary`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: slug, content: articleText }),
        signal: controller.signal,
      })
      const result = await response.json().catch(() => null)

      if (!response.ok) {
        throw new Error(result?.message || `请求失败（HTTP ${response.status}）`)
      }
      if (typeof result?.data !== 'string' || !result.data.trim()) {
        throw new Error('摘要服务返回了无效数据')
      }

      outputEl.textContent = result.data
    } catch (err) {
      const message =
        err instanceof DOMException && err.name === 'AbortError'
          ? '请求超时，请稍后再试'
          : err instanceof Error
            ? err.message
            : '未知错误'
      outputEl.textContent = `摘要生成失败: ${message}`
      outputEl.style.color = 'red'
    } finally {
      clearTimeout(timeoutId)
    }
  }, 500)
</script>
