---
interface Props {
  slug: string
  title: string
  body: string
  embedded?: boolean
}

const { slug, title, body, embedded = false } = Astro.props
const apiBaseUrl = 'https://summary.blueke.top'

const containerClass = embedded
  ? 'p-4 transition ai-summary-card data-pagefind-ignore'
  : 'mb-6 p-4 rounded-lg bg-amber-300/10 border border-amber-300 transition ai-summary-card data-pagefind-ignore'
---

<div id={`ai-summary-${slug}`} class={containerClass} data-ai-summary-state="loading">
  <div class="flex items-center gap-2 mb-2 font-bold">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="w-6 h-6"
      ><path d="M12 8V4H8"></path><rect width="16" height="12" x="4" y="8" rx="2"></rect><path
        d="M2 14h2"></path><path d="M20 14h2"></path><path d="M15 13v2"></path><path d="M9 13v2"
      ></path></svg
    >
    <span>AI 摘要</span>
  </div>
  <p id={`ai-summary-text-${slug}`} class="text-sm leading-relaxed opacity-80 break-words min-h-16">
    正在生成中...
  </p>
</div>

<script is:inline define:vars={{ slug, title, body, apiBaseUrl }}>
  ;(() => {
    const container = document.getElementById(`ai-summary-${slug}`)
    const outputEl = document.getElementById(`ai-summary-text-${slug}`)
    if (!container || !outputEl) return

    const storageKey = `gyoza-ai-summary:${slug}`
    const version = hash(`${title}\n${body}`)
    const requestKey = `${storageKey}:${version}`

    const setSummary = (text, failed = false) => {
      const currentOutput = document.getElementById(`ai-summary-text-${slug}`)
      const currentContainer = document.getElementById(`ai-summary-${slug}`)
      if (!currentOutput || !currentContainer) return

      currentOutput.textContent = text
      currentOutput.style.color = failed ? 'red' : ''
      currentContainer.dataset.aiSummaryState = failed ? 'error' : 'ready'
    }

    const readCache = () => {
      try {
        const cached = localStorage.getItem(storageKey)
        if (!cached) return null
        const parsed = JSON.parse(cached)
        if (parsed?.version !== version || typeof parsed.data !== 'string') return null
        return parsed.data.trim() || null
      } catch {
        return null
      }
    }

    const cached = readCache()
    if (cached) {
      setSummary(cached)
      return
    }

    const requests =
      window.__gyozaAiSummaryRequests || (window.__gyozaAiSummaryRequests = Object.create(null))
    const existingRequest = requests[requestKey]
    if (existingRequest) {
      existingRequest.then((text) => setSummary(text)).catch(() => {})
      return
    }

    const request = (async () => {
      const controller = new AbortController()
      const timeoutId = window.setTimeout(() => controller.abort(), 65_000)

      try {
        const articleText = `标题: ${title}\n\n${body}`
        const response = await fetch(`${apiBaseUrl}/api/summary`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: slug, content: articleText }),
          signal: controller.signal,
        })
        const result = await response.json().catch(() => null)

        if (!response.ok) {
          throw new Error(result?.message || `请求失败（HTTP ${response.status}）`)
        }
        if (typeof result?.data !== 'string' || !result.data.trim()) {
          throw new Error('摘要服务返回了无效数据')
        }

        const text = result.data.trim()
        try {
          localStorage.setItem(storageKey, JSON.stringify({ version, data: text }))
        } catch {
          // Ignore unavailable or full local storage; the in-flight result still applies.
        }
        return text
      } finally {
        window.clearTimeout(timeoutId)
      }
    })()

    requests[requestKey] = request
    request
      .then((text) => setSummary(text))
      .catch((err) => {
        const message =
          err instanceof DOMException && err.name === 'AbortError'
            ? '请求超时，请稍后再试'
            : err instanceof Error
              ? err.message
              : '未知错误'
        setSummary(`摘要生成失败: ${message}`, true)
      })
      .finally(() => {
        if (requests[requestKey] === request) delete requests[requestKey]
      })
  })()

  function hash(value) {
    let result = 5381
    for (let index = 0; index < value.length; index += 1) {
      result = (result * 33) ^ value.charCodeAt(index)
    }
    return (result >>> 0).toString(36)
  }
</script>
