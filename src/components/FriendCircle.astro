---
import '@/styles/components/friend-circle.css'
import cycleScriptUrl from '@/scripts/cycle.js?url'
---

<div class="friend-circle-layout">
  <div class="friend-circle-container md-lightbox-exclude">
    <div class="friend-circle-header mb-6">
      <h2 class="text-2xl font-bold flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-accent"
          ><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path></svg
        >
        朋友圈
      </h2>
      <p class="text-sm text-secondary mt-2">这里展示最近朋友们的更新动态...</p>
    </div>

    <div id="friend-circle-lite-root"></div>
  </div>

  <aside class="friend-circle-sidebar" aria-label="朋友圈控制台">
    <div class="friend-circle-sidebar-card">
      <div class="friend-circle-sidebar-title">
        <span class="friend-circle-status-dot"></span>
        朋友圈控制台
      </div>
      <p class="friend-circle-sidebar-description">
        API 服务提供文章聚合、友链状态和接口调试功能。
      </p>
      <div class="friend-circle-sidebar-links">
        <a href="https://api.friend.blueke.top/" target="_blank" rel="noopener noreferrer">
          <span>打开 API 控制台</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://api.friend.blueke.top/all" target="_blank" rel="noopener noreferrer">
          <span>查看全部动态</span>
          <span aria-hidden="true">↗</span>
        </a>
        <a href="https://api.friend.blueke.top/friend" target="_blank" rel="noopener noreferrer">
          <span>查看全部友链</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </aside>
</div>

<script is:inline>
  window.UserConfig = {
    private_api_url: 'https://api.friend.blueke.top/',
    page_turning_number: 12,
    error_img: 'https://fastly.jsdelivr.net/gh/Rock-Candy-Tea/Friend-Circle-Frontend/logo.png',
  }
</script>
<script is:inline type="module" define:vars={{ cycleScriptUrl }}>
  await import(cycleScriptUrl)
</script>
