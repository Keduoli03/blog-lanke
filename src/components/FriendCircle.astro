---
import '@/styles/components/friend-circle.css'
import cycleScriptUrl from '@/scripts/cycle.js?url'
---

<div class="friend-circle-container md-lightbox-exclude">
  <div class="friend-circle-header">
    <div class="friend-circle-header-left">
      <h2 class="text-2xl font-bold flex items-center gap-2">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="text-accent"
          ><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path
            d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
          ></path></svg
        >
        朋友圈
      </h2>
      <p class="text-sm text-secondary mt-2">这里展示最近朋友们的更新动态...</p>
    </div>
    <a
      class="friend-circle-api-link"
      href="https://api.friend.blueke.top/"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span>查看全部朋友圈</span>
      <span aria-hidden="true">↗</span>
    </a>
  </div>

  <div id="friend-circle-lite-root"></div>
</div>

<script is:inline>
  window.UserConfig = {
    private_api_url: 'https://api.friend.blueke.top/',
    page_turning_number: 12,
    error_img: 'https://fastly.jsdelivr.net/gh/Rock-Candy-Tea/Friend-Circle-Frontend/logo.png',
  }
</script>
<script is:inline type="module" define:vars={{ cycleScriptUrl }}>
  await import(cycleScriptUrl)
</script>
