---
import { color } from '@/config.json'

const accentCount = new Set(color.accent.map((accent) => `${accent.light}/${accent.dark}`)).size
---

<script is:inline define:vars={{ accentCount }}>
  ;(() => {
    const root = document.documentElement
    const storageKey = 'accent-color-shuffle-bag'

    function drawAccent() {
      let state = { remaining: [], last: null }
      try {
        const stored = JSON.parse(sessionStorage.getItem(storageKey) || 'null')
        if (stored?.count === accentCount && Array.isArray(stored.remaining)) state = stored
      } catch {
        // A random accent still works when session storage is unavailable.
      }

      if (state.remaining.length === 0) {
        state.remaining = Array.from({ length: accentCount }, (_, index) => index)
        for (let index = state.remaining.length - 1; index > 0; index -= 1) {
          const swapIndex = Math.floor(Math.random() * (index + 1))
          ;[state.remaining[index], state.remaining[swapIndex]] = [
            state.remaining[swapIndex],
            state.remaining[index],
          ]
        }
        if (state.remaining.at(-1) === state.last) {
          ;[state.remaining[0], state.remaining[state.remaining.length - 1]] = [
            state.remaining.at(-1),
            state.remaining[0],
          ]
        }
      }

      state.last = state.remaining.pop()
      root.dataset.accent = String(state.last ?? 0)
      try {
        sessionStorage.setItem(
          storageKey,
          JSON.stringify({ count: accentCount, remaining: state.remaining, last: state.last }),
        )
      } catch {
        // Keep the selected accent for this page only.
      }
    }

    drawAccent()
    document.addEventListener('swup:content:replace', drawAccent)
  })()
</script>
