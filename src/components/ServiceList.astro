---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'

const services = await getCollection('services')
---

<ul class="space-y-1">
  {
    services.map((service) => (
      <li class="group flex items-center gap-2 rounded-xl transition-colors duration-200 hover:bg-secondary/50">
        <a
          href={service.data.link}
          target="_blank"
          rel="noopener noreferrer external"
          class="group/service flex min-w-0 grow items-center gap-4 py-3.5 pl-4"
        >
          <div class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-accent/10 text-accent transition-colors duration-200 group-hover/service:bg-accent/20">
            <Icon name={service.data.icon} size={20} />
          </div>
          <div class="min-w-0 grow">
            <div class="truncate font-medium transition-colors duration-200 group-hover/service:text-accent">
              {service.data.title}
            </div>
            <p class="mt-0.5 truncate text-sm text-secondary">{service.data.description}</p>
          </div>
        </a>
        <div class="flex shrink-0 items-center gap-1 pr-3">
          <a
            href={service.data.link}
            target="_blank"
            rel="noopener noreferrer external"
            class="flex size-7 items-center justify-center rounded-md text-secondary opacity-0 transition-all duration-200 group-hover:opacity-50 group-focus-within:opacity-50 hover:bg-accent/10 hover:text-accent hover:opacity-100 focus-visible:opacity-100"
            aria-label={`访问 ${service.data.title}`}
            title="访问服务"
          >
            <Icon name="ri:external-link-line" size={16} />
          </a>
          {service.data.repository && (
            <a
              href={service.data.repository}
              target="_blank"
              rel="noopener noreferrer external"
              class="flex size-7 items-center justify-center rounded-md text-secondary opacity-50 transition-all duration-200 hover:bg-accent/10 hover:text-accent hover:opacity-100"
              aria-label={`在 GitHub 查看 ${service.data.title} 的源代码`}
              title="查看源代码"
            >
              <Icon name="ri:github-line" size={16} />
            </a>
          )}
        </div>
      </li>
    ))
  }
</ul>
