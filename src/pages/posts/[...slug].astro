---
import type { CollectionEntry } from 'astro:content'
import type { GetStaticPaths } from 'astro'
import MarkdownLayout from '@/layouts/MarkdownLayout.astro'
import { getSortedPosts, getEntrySlug } from '@/utils/content'
import { getPostRouteProps } from '@/utils/post-route'
import { getPostUrl } from '@/utils/post-url'
import MarkdownWrapper from '@/components/MarkdownWrapper.astro'
import SectionBlock from '@/components/SectionBlock.astro'
import { PostToc } from '@/components/post/PostToc'
import PostMetaInfo from '@/components/post/PostMetaInfo.astro'
import PostArchiveInfo from '@/components/post/PostArchiveInfo.astro'
import { ReadingProgress } from '@/components/post/ReadingProgress'
import Outdate from '@/components/post/Outdate.astro'
import PostNav from '@/components/post/PostNav.astro'
import { Comments } from '@/components/comment'
import { ActionAside } from '@/components/post/ActionAside'
import { PostCopyright } from '@/components/post/PostCopyright'
import AiSummary from '@/components/post/AiSummary.astro'
import { getDiffInDays } from '@/utils/date'
import { render } from 'astro:content'

export const getStaticPaths = (async () => {
  const sortedPosts = await getSortedPosts()

  return sortedPosts.flatMap((post, index) => {
    const props = getPostRouteProps(
      post,
      index > 0 ? sortedPosts[index - 1] : undefined,
      index < sortedPosts.length - 1 ? sortedPosts[index + 1] : undefined,
    )
    const slug = getEntrySlug(post)
    const legacyTitlePath = post.data.title

    return [
      { params: { slug }, props },
      ...(legacyTitlePath && legacyTitlePath !== slug
        ? [
            {
              params: { slug: legacyTitlePath },
              props: { redirect: getPostUrl(post) },
            },
          ]
        : []),
    ]
  })
}) satisfies GetStaticPaths

interface Props {
  current?: CollectionEntry<'posts'>
  prev?: CollectionEntry<'posts'>
  next?: CollectionEntry<'posts'>
  redirect?: string
}

const { current, prev, next, redirect } = Astro.props

if (!redirect && !current) throw new Error('Missing post for static route')

const redirectCanonical = redirect ? new URL(redirect, Astro.site) : undefined
const rendered = current ? await render(current) : undefined
const headings = rendered?.headings ?? []
const Content = rendered?.Content
const remarkPluginFrontmatter = rendered?.remarkPluginFrontmatter

const currentSlug = current ? getEntrySlug(current) : ''
const mdSlug = current ? getPostUrl(current) : ''

const mdDescription = current
  ? concat(current.data.category || '', current.data.tags.join(', '))
  : ''

function concat(str1: string, str2: string, sep = ' / ') {
  if (str1 && str2) return str1 + sep + str2
  if (str1) return str1
  if (str2) return str2
  return ''
}

const lastMod = current ? ((current.data.lastMod || current.data.date) as Date) : new Date(0)
// 1. 如果 frontmatter 明确设置了 outdate: true/false，则直接使用
// 2. 如果未设置(undefined)，则走默认逻辑：超过 90 天显示
const shouldShowOutdate =
  current &&
  (typeof current.data.outdate === 'boolean' ? current.data.outdate : getDiffInDays(lastMod) > 90)

const shouldShowAiSummary = current?.data.aiSummary
---

{
  redirect ? (
    <html lang="zh-CN">
      <head>
        <meta charset="utf-8" />
        <title>正在跳转</title>
        <link rel="canonical" href={redirectCanonical} />
        <meta http-equiv="refresh" content={`0;url=${redirect}`} />
      </head>
      <body>
        <p>
          此页面已迁移至 <a href={redirect}>{redirect}</a>。
        </p>
      </body>
    </html>
  ) : current && Content && remarkPluginFrontmatter ? (
    <MarkdownLayout
      title={current.data.title}
      description={current.data.summary}
      image={(current.data.cover || undefined) as string | undefined}
      mdTitle={current.data.title}
      mdDescription={mdDescription}
      mdSlug={mdSlug}
    >
      <div
        class="w-full max-w-full box-border px-4 md:px-8 py-16 grid gap-8 lg:grid-cols-[1fr_minmax(0,900px)_1fr]"
        data-pagefind-body
      >
        <div class="min-w-0 lg:col-start-2">
          <header class="space-y-4">
            {current.data.cover && (
              <div class="flex max-h-[680px] items-center justify-center overflow-hidden rounded-xl border border-secondary/40 bg-black/5 shadow-sm">
                <img
                  src={current.data.cover}
                  alt={current.data.title}
                  class="block h-auto max-h-[min(58vh,680px)] max-w-full w-auto object-contain"
                  loading="eager"
                />
              </div>
            )}
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold text-center break-words">
              {current.data.title}
            </h1>
            <PostMetaInfo
              class="justify-center"
              date={current.data.date as Date}
              lastMod={current.data.lastMod}
              words={remarkPluginFrontmatter.words}
              readingMinutes={remarkPluginFrontmatter.readingMinutes}
            />
            <PostArchiveInfo
              class="justify-center"
              category={current.data.category}
              tags={current.data.tags}
            />
            {
              /* Info Panel: 合并 Outdate 和 AiSummary */
              (shouldShowOutdate || shouldShowAiSummary) && (
                <div class="rounded-lg bg-amber-300/10 border border-amber-300 overflow-hidden">
                  {shouldShowOutdate && <Outdate lastMod={lastMod} />}
                  {shouldShowOutdate && shouldShowAiSummary && (
                    <div class="border-t border-amber-300/50 mx-4" />
                  )}
                  {shouldShowAiSummary && (
                    <AiSummary
                      slug={currentSlug}
                      title={current.data.title}
                      body={current.body ?? ''}
                      embedded={true}
                    />
                  )}
                </div>
              )
            }
          </header>
        </div>
        <div class="min-w-0 lg:col-start-2">
          <MarkdownWrapper>
            <Content />
          </MarkdownWrapper>
        </div>
        <div
          class="hidden xl:block lg:col-start-3 justify-self-start w-[260px]"
          data-pagefind-ignore
        >
          <aside class="sticky top-20">
            <SectionBlock title="目录">
              <PostToc headings={headings} client:load />
              <hr class="my-2 border-primary max-w-[100px]" />
              <ReadingProgress client:load />
            </SectionBlock>
            <ActionAside client:idle />
          </aside>
        </div>
        <div class="lg:col-start-2" data-pagefind-ignore>
          <section class="space-y-6">
            <PostCopyright
              title={current.data.title}
              slug={mdSlug}
              date={current.data.date as Date}
              lastMod={current.data.lastMod}
              client:visible
            />
            <PostNav prev={prev} next={next} />
            {current.data.comments && <Comments />}
          </section>
        </div>
      </div>
    </MarkdownLayout>
  ) : null
}
